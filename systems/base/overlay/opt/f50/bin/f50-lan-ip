#!/bin/sh
# The device's default LAN address, when /etc/f50/lan.conf sets none: the kind of device decides it, so that an
# F50 and a U30 Air on one computer do not collide (boot/init uses the same subnets before switch_root).
case $(${F50_BIN:-/opt/f50/bin}/f50-device) in
    u30air) echo 192.168.78.1 ;;
    *)      echo 192.168.77.1 ;;
esac
