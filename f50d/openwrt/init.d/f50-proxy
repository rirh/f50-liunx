#!/bin/sh /etc/rc.common
# f50-proxy: the proxy engine (One Node's client core, one-node/app/client, built for the F50: Xray-core with
# One Node's split routing), idle until f50d sends it a start request over its loopback API. After f50d (19): f50d writes the API token (/etc/f50d/proxy/token) at its start; without
# the token (the first boot, before f50d got there) the service is skipped and f50d starts it once it has written
# the token. f50d also removes the interception whenever this engine does not answer (f50-proxy/DESIGN.md).
START=20
STOP=11
USE_PROCD=1

BIN=/opt/f50/bin/f50-proxy
DIR=/etc/f50d/proxy

start_service() {
	[ -x "$BIN" ] || return 0
	[ -s "$DIR/token" ] || return 0
	level=$(cat "$DIR/log_level" 2>/dev/null)
	case "$level" in error | warning | info | debug) ;; *) level=warning ;; esac
	mkdir -p /var/log/f50-proxy
	procd_open_instance engine
	procd_set_param command "$BIN" serve --listen 127.0.0.1:17891 --token-file "$DIR/token" \
		--log /var/log/f50-proxy/core.log --loglevel "$level" --info-stdout \
		--cache-dir "$DIR/rulesets" --probe-limit 3 --link-key "$DIR/link.key" \
		--local-socks-listen 0.0.0.0 --local-socks-mark 255
	procd_set_param respawn 3600 5 0
	# --info-stdout: status and notes on stdout (daemon.info), trouble on stderr (daemon.err); --cache-dir keeps the
	# rule catalogue's sets across boots; --probe-limit: at most 3 throwaway Xray instances for delay tests at once;
	# --link-key: this router's OnLink device key (created at the first start, 0600), sent with subscription
	# downloads so the gateway serves onlink lines (bound to this device at its first download)
	# --local-socks-*: the nodes' 本地 SOCKS5 ports listen on every address (fw4 rejects WAN input, so only the LAN
	# and the USB host reach them) and their node connections carry the gateway mark (never intercepted again)
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
