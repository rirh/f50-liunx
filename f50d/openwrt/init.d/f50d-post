#!/bin/sh /etc/rc.common
# f50d boot stage "post": 30 s after everything else, the boot counts as good - the Linux slot is re-armed with its
# attempts (or locked) and the initramfs' boot count cleared (mu300-next-boot --rearm). Without this, N boots in a
# row and LK falls back to Android. Replaces mu300-post's bootok instance; its other instances are the daemon's.
START=99
USE_PROCD=1

start_service() {
	procd_open_instance bootok
	procd_set_param command /usr/sbin/f50d boot post
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
