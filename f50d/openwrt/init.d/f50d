#!/bin/sh /etc/rc.common
# f50d: the F50's device daemon - the modem, mobile data, SMS, Wi-Fi/LAN/USB, the system and updates, published on
# ubus (f50.*). After the keeper (13) and the hardware stage (12), before netifd (20) asks it to dial: netifd's
# f50cell handler retries by itself while f50d is not registered yet.
START=19
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance daemon
	procd_set_param command /usr/sbin/f50d daemon
	procd_set_param respawn 3600 5 0
	# f50d drains its tasks for up to 20 s on SIGTERM
	procd_set_param term_timeout 25
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	restart
}
